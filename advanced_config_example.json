# Example Advanced Configuration for Maximum Protection
# Copy this to your working directory and customize as needed

# This configuration demonstrates how to extend the blocklist sources
# for maximum protection by adding more aggressive and comprehensive sources

{
  "metadata": {
    "name": "Maximum Protection Configuration",
    "description": "Ultra-comprehensive blocklist collection for maximum security",
    "version": "1.1.0",
    "last_updated": "2024-01-01"
  },
  "additional_sources": {
    "ultra_aggressive": [
      {
        "name": "OISD Full List",
        "url": "https://hosts.oisd.nl/",
        "description": "Comprehensive list including everything",
        "format": "domain",
        "update_frequency": "daily"
      },
      {
        "name": "1Hosts Lite",
        "url": "https://o0.pages.dev/Lite/hosts.txt",
        "description": "Lightweight but comprehensive protection",
        "format": "hosts",
        "update_frequency": "daily"
      },
      {
        "name": "AdGuard DNS Filter Extended",
        "url": "https://adguardteam.github.io/AdguardFilters/BaseFilter/sections/general_extensions.txt",
        "description": "Extended AdGuard protection",
        "format": "adblock",
        "update_frequency": "daily"
      }
    ],
    "security_focused": [
      {
        "name": "Cybercrime Tracker",
        "url": "http://cybercrime-tracker.net/all.php",
        "description": "Active cybercrime domains",
        "format": "domain",
        "update_frequency": "hourly"
      },
      {
        "name": "Abuse.ch URLhaus",
        "url": "https://urlhaus.abuse.ch/downloads/hostfile/",
        "description": "Malware URL hosting domains",
        "format": "hosts",
        "update_frequency": "hourly"
      },
      {
        "name": "Feodo Tracker",
        "url": "https://feodotracker.abuse.ch/downloads/ipblocklist.txt",
