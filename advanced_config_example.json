        "update_frequency": "weekly"
      },
      {
        "name": "Smart TV Ads",
        "url": "https://raw.githubusercontent.com/Perflyst/PiHoleBlocklist/master/SmartTV-AGH.txt",
        "description": "Smart TV tracking and ads",
        "format": "domain",
        "update_frequency": "weekly"
      },
      {
        "name": "Windows Telemetry",
        "url": "https://raw.githubusercontent.com/crazy-max/WindowsSpyBlocker/master/data/hosts/spy.txt",
        "description": "Windows 10/11 telemetry blocking",
        "format": "hosts",
        "update_frequency": "weekly"
      }
    ]
  },
  "custom_categories": {
    "gaming": [
      {
        "name": "Game Ads and Tracking",
        "url": "https://raw.githubusercontent.com/DandelionSprout/adfilt/master/GameConsoleAdblockList.txt",
        "description": "Gaming console ads and tracking",
        "format": "adblock",
        "update_frequency": "weekly"
      }
    ],
    "iot_security": [
      {
        "name": "IoT Malware Domains",
        "url": "https://raw.githubusercontent.com/stamparm/maltrail/master/trails/static/malware/iot.txt",
        "description": "IoT-specific malware domains",
        "format": "domain",
        "update_frequency": "daily"
      }
    ]
  },
  "whitelist_additions": [
    "# Add critical domains that should never be blocked",
    "# even in maximum protection mode",
    "",
    "# Banking",
    "secure.bankofamerica.com",
    "online.wellsfargo.com",
    "secure.chase.com",
    "",
    "# Streaming services",
    "netflix.com",
    "hulu.com",
    "amazon.com",
    "primevideo.com",
    "",
    "# Essential CDNs",
    "cdnjs.cloudflare.com",
    "unpkg.com",
    "maxcdn.bootstrapcdn.com",
    "",
    "# Development",
    "github.com",
    "stackoverflow.com",
    "npmjs.com"
  ],
  "update_schedule": {
    "high_priority": ["malware", "phishing", "security_focused"],
    "medium_priority": ["advertising", "tracking", "privacy"],
    "low_priority": ["social_media", "gaming", "content_filtering"]
  },
  "performance_settings": {
    "max_domains_per_category": 1000000,
    "enable_compression": true,
    "parallel_downloads": 5,
    "retry_attempts": 5,
    "timeout_seconds": 60
  },
  "output_options": {
    "generate_category_files": true,
    "generate_combined_file": true,
    "include_statistics": true,
    "compression_format": "gzip",
    "backup_previous": true
  }
}