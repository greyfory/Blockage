      }
    ],
    "privacy_extreme": [
      {
        "name": "AdGuard Annoyances",
        "url": "https://filters.adtidy.org/extension/chromium/filters/14.txt",
        "description": "Remove annoyances and notifications",
        "format": "adblock",
        "update_frequency": "daily"
      },
      {
        "name": "uBlock Annoyances",
        "url": "https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/annoyances.txt",
        "description": "uBlock Origin annoyances filter",
        "format": "adblock",
        "update_frequency": "daily"
      }
    ],
    "content_filtering": [
      {
        "name": "YouTube Ads",
